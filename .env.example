# TenderBot / Lead Factory local configuration template.
# Copy to .env and fill only the integrations you explicitly intend to use.
# The v7 recovery baseline is offline and default-off: blank credentials are valid
# for tests and local status checks.  Never commit the populated .env.

# Tender and enrichment APIs
DAMIA_KEY=
OPENROUTER_KEY=
TWOGIS_KEY=
SERPER_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_SEARCH_API_KEY=

# Legacy SMTP delivery
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Inbound mailbox
MANAGER_IMAP_HOST=
MANAGER_IMAP_USER=
MANAGER_IMAP_PASSWORD=
SEED_MAILBOX=

# Telegram and Bitrix
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BITRIX_WEBHOOK=
BITRIX_TASKS_WEBHOOK=
BITRIX_GRAPH_CANARY_WEBHOOK=

# Unisender / legacy campaigns.  Recovery keeps sending disabled.
UNISENDER_GO_API_KEY=
UNISENDER_GO_HOST=
CAMPAIGN_DRY_RUN=1
CAMPAIGN_DAILY_CAP=0
CAMPAIGN_FROM_EMAIL=
CAMPAIGN_FROM_EMAIL_2=
CAMPAIGN_FROM_EMAILS=
CAMPAIGN_FROM_NAME=
CAMPAIGN_REPLY_TO=
CAMPAIGN_SENDER=
CAMPAIGN_SMTP_HOST=

# Webhook tooling
CLOUDFLARED_PATH=
WEBHOOK_PORT=8765

# Portable local input directory for tb_load_prozvon.py and related exports.
# Relative paths are resolved from the project root.
TENDERBOT_PROZVON_DIR=
