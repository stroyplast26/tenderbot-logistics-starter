# TaskBot is an optional live sidecar, not part of the offline v7 recovery.
# Copy to taskbot/.env only when its Telegram and Bitrix connections are approved.

TASKBOT_TELEGRAM_TOKEN=
BITRIX_TASKS_WEBHOOK=

# Prefer a direct key.  OPENROUTER_SETTINGS_PATH is only a portable fallback and
# must not point to another user's profile or an unrelated application.
OPENROUTER_API_KEY=
OPENROUTER_SETTINGS_PATH=
TASKBOT_TEXT_MODEL=anthropic/claude-sonnet-4.5
TASKBOT_SPEECH_MODEL=openai/whisper-1

TASKBOT_ADMIN_TG_IDS=
TASKBOT_MORNING_HOUR=9
TASKBOT_EVENING_HOUR=18
TASKBOT_NOTIFY_FROM_HOUR=9
TASKBOT_NOTIFY_UNTIL_HOUR=21
TASKBOT_REMINDER_SYNC_SECONDS=300
