{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumkomplekt-rf.ru/schemas/mdos/v7/order-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "distinct_order_id", "demand_unit_id", "account_id", "scope_fingerprint", "commercial_terms_ref", "state", "approved_by", "approved_at", "version", "payload_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "distinct_order_id": {"type": "string", "minLength": 1},
    "demand_unit_id": {"type": "string", "minLength": 1},
    "account_id": {"type": "string", "minLength": 1},
    "scope_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commercial_terms_ref": {"type": "string", "minLength": 1},
    "state": {"enum": ["DRAFT", "APPROVED", "PAID_PARTIAL", "PAID", "IN_FULFILMENT", "FULFILLED", "CANCELLED", "REFUNDED"]},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1},
    "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
