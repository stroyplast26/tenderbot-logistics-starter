{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumkomplekt-rf.ru/schemas/mdos/v7.2/telephony-data-policy.schema.json",
  "title": "MDOS v7.2 TelephonyDataPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "policy_id",
    "purpose_code",
    "legal_basis_code",
    "notice_policy_id",
    "retention_days",
    "access_roles",
    "processor_contract_ref",
    "raw_download_to_lead_factory_allowed",
    "external_ai_allowed",
    "status",
    "approved_by_role",
    "approved_at_utc",
    "evidence_ref"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "TELEPHONY_DATA_POLICY"},
    "policy_id": {"$ref": "#/$defs/id"},
    "purpose_code": {"$ref": "#/$defs/id"},
    "legal_basis_code": {"$ref": "#/$defs/id"},
    "notice_policy_id": {"$ref": "#/$defs/id"},
    "retention_days": {"type": "integer", "minimum": 0, "maximum": 3650},
    "access_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "processor_contract_ref": {"$ref": "#/$defs/ref"},
    "raw_download_to_lead_factory_allowed": {"const": false},
    "external_ai_allowed": {"const": false},
    "status": {"enum": ["DRAFT_NOT_APPROVED", "APPROVED", "REVOKED"]},
    "approved_by_role": {"$ref": "#/$defs/id"},
    "approved_at_utc": {"$ref": "#/$defs/utc"},
    "evidence_ref": {"$ref": "#/$defs/evidence"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "ref": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+$"},
    "evidence": {"type": "string", "pattern": "^evidence://[A-Za-z0-9][A-Za-z0-9._:/-]{0,2028}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
