{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumkomplekt-rf.ru/schemas/mdos/v7/gold-acceptance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gold_acceptance_id", "demand_unit_id", "scope_fingerprint", "cohort_id", "denominator_snapshot_ref", "motion", "reviewer_id", "reviewed_at", "cutoff_at", "evidence_bundle_ref", "capacity_snapshot_ref", "economics_snapshot_ref", "permit_decision_ref", "permitted_next_action", "decision", "reason_codes", "version"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "gold_acceptance_id": {"type": "string", "minLength": 1},
    "demand_unit_id": {"type": "string", "minLength": 1},
    "scope_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cohort_id": {"type": "string", "minLength": 1},
    "denominator_snapshot_ref": {"type": "string", "minLength": 1},
    "motion": {"type": "string", "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "cutoff_at": {"type": "string", "format": "date-time"},
    "evidence_bundle_ref": {"type": "string", "minLength": 1},
    "capacity_snapshot_ref": {"type": "string", "minLength": 1},
    "economics_snapshot_ref": {"type": "string", "minLength": 1},
    "permit_decision_ref": {"type": "string", "minLength": 1},
    "permitted_next_action": {"type": "string", "minLength": 1},
    "decision": {"enum": ["ACCEPTED", "REJECTED", "REVOKED"]},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "version": {"type": "integer", "minimum": 1}
  }
}
