{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumkomplekt-rf.ru/schemas/mdos/v7.2/call-interaction.schema.json",
  "title": "MDOS v7.2 CallInteraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "call_session_id",
    "provider",
    "provider_entry_id",
    "state",
    "legs",
    "crm_binding",
    "review_reasons",
    "recorded_at_utc",
    "evidence_ref"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "CALL_INTERACTION"},
    "call_session_id": {"$ref": "#/$defs/id"},
    "provider": {"const": "MANGO"},
    "provider_entry_id": {"$ref": "#/$defs/id"},
    "state": {
      "enum": [
        "UNBOUND_EVIDENCE",
        "UNBOUND_CALL",
        "BOUND",
        "RECORDING_READY",
        "TRANSCRIPT_READY",
        "ANALYSIS_DRAFT",
        "OPERATOR_CONFIRMED",
        "REVIEW_REQUIRED"
      ]
    },
    "legs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_call_id",
          "sequence",
          "direction",
          "started_at_utc",
          "completed_at_utc",
          "duration_seconds"
        ],
        "properties": {
          "provider_call_id": {"$ref": "#/$defs/id"},
          "sequence": {"type": "integer", "minimum": 0},
          "direction": {"enum": ["INBOUND", "OUTBOUND"]},
          "started_at_utc": {"$ref": "#/$defs/utc"},
          "completed_at_utc": {"$ref": "#/$defs/utc"},
          "duration_seconds": {"type": "integer", "minimum": 0, "maximum": 86400}
        }
      }
    },
    "crm_binding": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bitrix_call_id",
            "crm_activity_id",
            "lf_opportunity_id",
            "lf_task_id",
            "operator_actor"
          ],
          "properties": {
            "bitrix_call_id": {"$ref": "#/$defs/id"},
            "crm_activity_id": {"$ref": "#/$defs/id"},
            "lf_opportunity_id": {"$ref": "#/$defs/id"},
            "lf_task_id": {"$ref": "#/$defs/id"},
            "operator_actor": {"$ref": "#/$defs/id"},
            "candidate_snapshot_sha256": {"$ref": "#/$defs/digest"}
          }
        }
      ]
    },
    "review_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "recorded_at_utc": {"$ref": "#/$defs/utc"},
    "evidence_ref": {"$ref": "#/$defs/evidence"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {"type": "string", "pattern": "^evidence://[A-Za-z0-9][A-Za-z0-9._:/-]{0,2028}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
