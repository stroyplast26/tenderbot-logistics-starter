{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumkomplekt-rf.ru/schemas/mdos/v7.2/telephony-pilot.schema.json",
  "title": "MDOS v7.2 TelephonyPilot",
  "$comment": "Timestamp order, actor separation and the 24-hour interval are enforced by lead_factory.mdos_v7.successor_semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "pilot_id",
    "status",
    "contract_id",
    "package_version",
    "package_root_sha256",
    "permit_ref",
    "portal_scope_id",
    "operator_actor",
    "controller_actor",
    "starts_at_utc",
    "expires_at_utc",
    "contact_scope",
    "participant_allowlist_refs",
    "max_calls",
    "max_wip",
    "manual_checkpoint_after_calls",
    "raw_download_to_lead_factory_enabled",
    "external_ai_enabled",
    "auto_dial_enabled",
    "tenderplan_enabled",
    "stop_conditions",
    "max_duration_hours",
    "stop_evidence_ref"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "TELEPHONY_PILOT"},
    "pilot_id": {"$ref": "#/$defs/id"},
    "status": {"const": "DRAFT_NOT_RATIFIED"},
    "contract_id": {"const": "AK-MDOS-V7"},
    "package_version": {"const": "7.2.0-rc.2"},
    "package_root_sha256": {"$ref": "#/$defs/digest"},
    "permit_ref": {"$ref": "#/$defs/ref"},
    "portal_scope_id": {"$ref": "#/$defs/id"},
    "operator_actor": {"$ref": "#/$defs/id"},
    "controller_actor": {"$ref": "#/$defs/id"},
    "starts_at_utc": {"$ref": "#/$defs/utc"},
    "expires_at_utc": {"$ref": "#/$defs/utc"},
    "contact_scope": {"const": "INTERNAL_TEST_ONLY"},
    "participant_allowlist_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "max_calls": {"type": "integer", "minimum": 1, "maximum": 5},
    "max_wip": {"const": 1},
    "manual_checkpoint_after_calls": {"const": 1},
    "raw_download_to_lead_factory_enabled": {"const": false},
    "external_ai_enabled": {"const": false},
    "auto_dial_enabled": {"const": false},
    "tenderplan_enabled": {"const": false},
    "stop_conditions": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "enum": [
          "notice_missing",
          "consent_missing",
          "scope_mismatch",
          "unexpected_participant",
          "recording_failure",
          "crm_binding_conflict",
          "duplicate_effect",
          "ambiguous_or_unknown_outcome",
          "raw_or_secret_leak",
          "cap_or_wip_exceeded",
          "stop_unavailable",
          "controller_stop"
        ]
      }
    },
    "max_duration_hours": {"const": 24},
    "stop_evidence_ref": {"$ref": "#/$defs/evidence"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+$"},
    "evidence": {"type": "string", "pattern": "^evidence://[A-Za-z0-9][A-Za-z0-9._:/-]{0,2028}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
