{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumkomplekt-rf.ru/schemas/mdos/v7/permit-decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "permit_decision_id", "decision", "purpose", "action_type", "channel", "scope", "subject_refs", "legal_basis_ref", "source_passport_ref", "issued_by", "issued_at", "expires_at", "policy_version", "capacity_snapshot_ref", "max_cost", "currency", "evidence_refs", "payload_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "permit_decision_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["ALLOW", "DENY"]},
    "purpose": {"type": "string", "minLength": 1},
    "action_type": {"type": "string", "minLength": 1},
    "channel": {"type": "string", "minLength": 1},
    "scope": {"type": "object", "additionalProperties": false, "required": ["beachhead_profile_ref", "region", "product_scope"], "properties": {"beachhead_profile_ref": {"type": ["string", "null"]}, "region": {"type": "string", "minLength": 1}, "product_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
    "subject_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "legal_basis_ref": {"type": "string", "minLength": 1},
    "source_passport_ref": {"type": "string", "minLength": 1},
    "issued_by": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "policy_version": {"type": "string", "minLength": 1},
    "capacity_snapshot_ref": {"type": "string", "minLength": 1},
    "max_cost": {"type": "number", "minimum": 0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
