{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumkomplekt-rf.ru/schemas/mdos/v7.2/operator-adjudication.schema.json",
  "title": "MDOS v7.2 OperatorAdjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "call_session_id",
    "bitrix_call_id",
    "crm_activity_id",
    "lf_opportunity_id",
    "lf_task_id",
    "operator_actor",
    "confirmation_version",
    "technical_disposition",
    "commercial_disposition",
    "next_action",
    "next_action_at_utc",
    "next_action_owner",
    "terminal_reason_code",
    "recording_notice_status",
    "draft_id",
    "review_reasons",
    "confirmed_at_utc",
    "evidence_ref"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "OPERATOR_ADJUDICATION"},
    "call_session_id": {"$ref": "#/$defs/id"},
    "bitrix_call_id": {"$ref": "#/$defs/id"},
    "crm_activity_id": {"$ref": "#/$defs/id"},
    "lf_opportunity_id": {"$ref": "#/$defs/id"},
    "lf_task_id": {"$ref": "#/$defs/id"},
    "operator_actor": {"$ref": "#/$defs/id"},
    "confirmation_version": {"type": "integer", "minimum": 1},
    "technical_disposition": {"$ref": "#/$defs/id"},
    "commercial_disposition": {"$ref": "#/$defs/id"},
    "next_action": {"$ref": "#/$defs/id"},
    "next_action_at_utc": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/utc"}]},
    "next_action_owner": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/id"}]},
    "terminal_reason_code": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/id"}]},
    "recording_notice_status": {"enum": ["CONFIRMED", "NOT_APPLICABLE", "UNKNOWN"]},
    "draft_id": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/id"}]},
    "review_reasons": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "confirmed_at_utc": {"$ref": "#/$defs/utc"},
    "evidence_ref": {"$ref": "#/$defs/evidence"}
  },
  "oneOf": [
    {
      "properties": {
        "next_action": {"const": "NONE"},
        "next_action_at_utc": {"const": ""},
        "next_action_owner": {"const": ""},
        "terminal_reason_code": {"$ref": "#/$defs/id"}
      }
    },
    {
      "properties": {
        "next_action": {"not": {"const": "NONE"}},
        "next_action_at_utc": {"$ref": "#/$defs/utc"},
        "next_action_owner": {"$ref": "#/$defs/id"},
        "terminal_reason_code": {"const": ""}
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "evidence": {"type": "string", "pattern": "^evidence://[A-Za-z0-9][A-Za-z0-9._:/-]{0,2028}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
