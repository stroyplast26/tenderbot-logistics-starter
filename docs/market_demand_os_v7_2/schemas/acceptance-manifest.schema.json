{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumkomplekt-rf.ru/schemas/mdos/v7.2/acceptance-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_id", "manifest_version", "contract_id", "package_version", "acceptance_cases"],
  "properties": {
    "manifest_id": {"const": "MDOS-V7-ACCEPTANCE"},
    "manifest_version": {"type": "string"},
    "contract_id": {"const": "AK-MDOS-V7"},
    "package_version": {"type": "string"},
    "acceptance_cases": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["id", "document", "line", "scenario", "expected_result", "case_sha256", "owner_role", "execution_status", "coverage", "test_bindings", "evidence_refs"], "properties": {"id": {"type": "string", "pattern": "^AT-[A-Z0-9-]+-[0-9]{2}$"}, "document": {"type": "string"}, "line": {"type": "integer", "minimum": 1}, "scenario": {"type": "string"}, "expected_result": {"type": "string"}, "case_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "owner_role": {"type": "string"}, "execution_status": {"enum": ["SPECIFIED_NOT_IMPLEMENTED", "IMPLEMENTED_NOT_VERIFIED", "VERIFIED", "FAILED", "REVOKED"]}, "coverage": {"enum": ["NONE", "PARTIAL", "FULL"]}, "test_bindings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}}
  }
}
