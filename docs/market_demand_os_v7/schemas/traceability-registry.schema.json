{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumkomplekt-rf.ru/schemas/mdos/v7/traceability-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "registry_version", "contract_id", "package_version", "edges"],
  "properties": {
    "registry_id": {"const": "MDOS-V7-TRACEABILITY"},
    "registry_version": {"type": "string"},
    "contract_id": {"const": "AK-MDOS-V7"},
    "package_version": {"type": "string"},
    "edges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["edge_id", "from_id", "from_digest", "edge_type", "to_id", "to_digest", "status", "created_at"], "properties": {"edge_id": {"type": "string"}, "from_id": {"type": "string"}, "from_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "edge_type": {"enum": ["SATISFIED_BY", "IMPLEMENTED_BY", "VERIFIED_BY", "PRODUCED_EVIDENCE"]}, "to_id": {"type": "string"}, "to_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "status": {"enum": ["SPECIFIED", "ACTIVE", "REVOKED"]}, "created_at": {"type": "string", "format": "date-time"}}}}
  }
}
