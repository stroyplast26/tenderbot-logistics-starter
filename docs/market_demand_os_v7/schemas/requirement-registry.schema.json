{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumkomplekt-rf.ru/schemas/mdos/v7/requirement-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "registry_version", "contract_id", "package_version", "requirements"],
  "properties": {
    "registry_id": {"const": "MDOS-V7-REQUIREMENTS"},
    "registry_version": {"type": "string"},
    "contract_id": {"const": "AK-MDOS-V7"},
    "package_version": {"type": "string"},
    "requirements": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "document", "line", "text_sha256", "owner_role", "criticality", "applicable_tiers", "status", "acceptance_ids", "design_bindings", "code_bindings", "test_bindings", "evidence_refs"], "properties": {"id": {"type": "string", "pattern": "^MDOS-[A-Z0-9-]+-[0-9]{3}$"}, "document": {"type": "string"}, "line": {"type": "integer", "minimum": 1}, "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "owner_role": {"type": "string"}, "criticality": {"enum": ["P0", "P1", "P2", "P3"]}, "applicable_tiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "status": {"enum": ["DEFINED", "DESIGNED", "IMPLEMENTED", "VERIFIED", "PRODUCTION_PROVEN", "RETIRED"]}, "acceptance_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^AT-[A-Z0-9-]+-[0-9]{2}$"}}, "design_bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "code_bindings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "test_bindings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}}
  }
}
