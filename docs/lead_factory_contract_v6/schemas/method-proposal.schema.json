{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumkomplekt.local/lead-factory/v6/method-proposal.schema.json",
  "title": "Lead Factory Method Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "method_id", "method_version", "status", "owner_role", "funnel", "problem",
    "hypothesis", "causal_mechanism", "target_cohort", "exclusions", "primary_factor",
    "control_design", "primary_metric", "guardrails", "denominator", "maturity_window",
    "sample_plan", "budget_capacity", "legal_data_requirements", "success_rule",
    "stop_rule", "rollback_plan", "evidence_refs"
  ],
  "properties": {
    "method_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{3,127}$"},
    "method_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "status": {"enum": ["PROPOSED", "SCREENED", "APPROVED_OFFLINE", "SHADOW", "CANARY", "PILOT", "SCALE_ELIGIBLE", "PROVEN", "REVISE", "STOPPED", "RETIRED"]},
    "owner_role": {"type": "string", "minLength": 2},
    "funnel": {"enum": ["DEALER_ACQUISITION", "END_CUSTOMER_ROUTING", "PROJECT_TENDER"]},
    "problem": {"type": "string", "minLength": 10, "maxLength": 2000},
    "hypothesis": {"type": "string", "minLength": 10, "maxLength": 2000},
    "causal_mechanism": {"type": "string", "minLength": 10, "maxLength": 3000},
    "target_cohort": {"type": "object"},
    "exclusions": {"type": "array", "items": {"type": "string", "minLength": 2}},
    "primary_factor": {"type": "string", "minLength": 2},
    "control_design": {"type": "object"},
    "primary_metric": {"type": "string", "minLength": 2},
    "guardrails": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "denominator": {"type": "string", "minLength": 2},
    "maturity_window": {"type": "string", "minLength": 2},
    "sample_plan": {"type": "object"},
    "budget_capacity": {"type": "object"},
    "legal_data_requirements": {"type": "array", "items": {"type": "string", "minLength": 2}},
    "success_rule": {"type": "string", "minLength": 2},
    "stop_rule": {"type": "string", "minLength": 2},
    "rollback_plan": {"type": "string", "minLength": 2},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
  }
}

