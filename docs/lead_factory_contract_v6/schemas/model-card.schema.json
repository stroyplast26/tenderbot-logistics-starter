{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumkomplekt.local/lead-factory/v6/model-card.schema.json",
  "title": "Lead Factory Model Card v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_card_id", "role", "provider", "model_exact_id", "model_release",
    "prompt_package_id", "input_schema_id", "output_schema_id", "allowed_data_classes",
    "purpose", "tool_policy", "evaluation_manifest_id", "calibration_status",
    "valid_from_utc", "valid_until_utc", "rollback_model_card_id", "status"
  ],
  "properties": {
    "model_card_id": {"type": "string", "minLength": 8},
    "role": {"type": "string", "minLength": 2},
    "provider": {"type": "string", "minLength": 2},
    "model_exact_id": {"type": "string", "minLength": 2},
    "model_release": {"type": "string", "minLength": 1},
    "prompt_package_id": {"type": "string", "minLength": 2},
    "input_schema_id": {"type": "string", "minLength": 2},
    "output_schema_id": {"type": "string", "minLength": 2},
    "allowed_data_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "purpose": {"type": "string", "minLength": 8},
    "tool_policy": {"enum": ["NO_TOOLS", "ALLOWLIST_ONLY"]},
    "evaluation_manifest_id": {"type": "string", "minLength": 2},
    "calibration_status": {"enum": ["UNKNOWN", "SHADOW_VALIDATED", "PRODUCTION_VALIDATED", "DRIFTED"]},
    "valid_from_utc": {"type": "string", "format": "date-time"},
    "valid_until_utc": {"type": "string", "format": "date-time"},
    "rollback_model_card_id": {"type": ["string", "null"]},
    "status": {"enum": ["DRAFT", "SHADOW", "CANARY", "ACTIVE", "PAUSED", "REVOKED", "EXPIRED"]}
  }
}

