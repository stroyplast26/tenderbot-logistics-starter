{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumkomplekt.local/lead-factory/v6/quality-conflict.schema.json",
  "title": "Lead Factory Quality Conflict v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["conflict_id", "fact_class", "status", "claim_refs", "dependent_actions", "opened_at_utc", "owner_role", "severity"],
  "properties": {
    "conflict_id": {"type": "string", "minLength": 8},
    "fact_class": {"enum": ["PAYMENT", "ORDER", "CONSENT", "SUPPRESSION", "SOURCE_OBSERVATION", "IDENTITY", "ICP", "AGCO", "CAPACITY", "PROMISE", "DISPOSITION", "ATTRIBUTION"]},
    "status": {"enum": ["OPEN", "QUARANTINED", "RESOLVED", "OVERRIDDEN", "APPEALED"]},
    "claim_refs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "dependent_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "opened_at_utc": {"type": "string", "format": "date-time"},
    "owner_role": {"type": "string", "minLength": 2},
    "severity": {"enum": ["P0", "P1", "P2", "P3"]},
    "resolution": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["decision", "arbiter_id", "authority_ref", "evidence_refs", "resolved_at_utc"],
      "properties": {
        "decision": {"enum": ["CONFIRM_CLAIM", "REJECT_CLAIM", "KEEP_CONFLICT", "SCOPED_OVERRIDE"]},
        "arbiter_id": {"type": "string", "minLength": 2},
        "authority_ref": {"type": "string", "minLength": 2},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "resolved_at_utc": {"type": "string", "format": "date-time"},
        "expires_at_utc": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}

