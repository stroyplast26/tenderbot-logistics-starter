{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumkomplekt.local/lead-factory/v6/acceptance-manifest.schema.json",
  "title": "Lead Factory Acceptance Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_id", "manifest_version", "contract_id", "package_version", "acceptance_cases"],
  "properties": {
    "manifest_id": {"const": "LF-V6-ACCEPTANCE"},
    "manifest_version": {"type": "string", "minLength": 1},
    "contract_id": {"const": "LF-OUTCOME-V6"},
    "package_version": {"type": "string", "minLength": 1},
    "acceptance_cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "document", "line", "scenario", "expected_result", "owner_role", "execution_status", "test_bindings", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^AT-[A-Z0-9-]+-\\d{2}$"},
          "document": {"type": "string", "minLength": 3},
          "line": {"type": "integer", "minimum": 1},
          "scenario": {"type": "string", "minLength": 2},
          "expected_result": {"type": "string", "minLength": 2},
          "owner_role": {"type": "string", "minLength": 2},
          "execution_status": {"enum": ["SPECIFIED_NOT_IMPLEMENTED", "IMPLEMENTED_NOT_RUN", "PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE"]},
          "test_bindings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
          "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}}
        }
      }
    }
  }
}

