{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumkomplekt.local/lead-factory/v6/event-envelope.schema.json",
  "title": "Lead Factory Domain Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "event_type", "schema_version", "aggregate_type", "aggregate_id",
    "aggregate_version", "occurred_at_utc", "recorded_at_utc", "actor_id",
    "authority_ref", "correlation_id", "causation_id", "contract_version",
    "policy_version", "payload", "payload_sha256", "evidence_refs"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 8, "maxLength": 160},
    "event_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,99}$"},
    "schema_version": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "aggregate_type": {"type": "string", "minLength": 2, "maxLength": 80},
    "aggregate_id": {"type": "string", "minLength": 4, "maxLength": 160},
    "aggregate_version": {"type": "integer", "minimum": 1},
    "occurred_at_utc": {"type": "string", "format": "date-time"},
    "recorded_at_utc": {"type": "string", "format": "date-time"},
    "actor_id": {"type": "string", "minLength": 2, "maxLength": 160},
    "authority_ref": {"type": "string", "minLength": 2, "maxLength": 240},
    "correlation_id": {"type": "string", "minLength": 4, "maxLength": 160},
    "causation_id": {"type": "string", "minLength": 4, "maxLength": 160},
    "contract_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "source_version": {"type": ["string", "null"], "maxLength": 128},
    "method_version": {"type": ["string", "null"], "maxLength": 128},
    "model_version": {"type": ["string", "null"], "maxLength": 128},
    "payload": {"type": "object"},
    "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_refs": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 512}
    }
  }
}

