{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumkomplekt.local/lead-factory/v6/release-evidence.schema.json",
  "title": "Lead Factory Release Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id", "release_sha256", "created_at_utc", "source_tree_sha256",
    "contract_manifest_sha256", "target_scale_tier", "artifacts", "gates",
    "approvals", "rollback_ref", "external_authority_default"
  ],
  "properties": {
    "release_id": {"type": "string", "minLength": 8, "maxLength": 160},
    "release_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "source_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contract_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target_scale_tier": {"enum": ["T0_OFFLINE", "T1_SHADOW", "T2_BOUNDED_CANARY", "T3_CONTROLLED_PRODUCTION", "T4_MULTI_METHOD_GCO10", "T5_RESILIENT_OPERATION"]},
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "id", "version", "sha256"],
        "properties": {
          "kind": {"type": "string", "minLength": 2},
          "id": {"type": "string", "minLength": 2},
          "version": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "gates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gate_id", "status", "evidence_sha256"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 2},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE"]},
          "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "approvals": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["principal_id", "role", "decision", "decided_at_utc"],
        "properties": {
          "principal_id": {"type": "string", "minLength": 2},
          "role": {"type": "string", "minLength": 2},
          "decision": {"enum": ["APPROVE", "REJECT"]},
          "decided_at_utc": {"type": "string", "format": "date-time"}
        }
      }
    },
    "rollback_ref": {"type": "string", "minLength": 2},
    "external_authority_default": {"const": "DISABLED"}
  }
}

